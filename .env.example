# Copy this file to .env and adjust if your services run on different
# hosts/ports. Every value below has a sane default in app/config.py,
# so this file is optional for a local, single-machine demo.

# ui-service's own bind address
HOST=0.0.0.0
PORT=8007

# The ONLY downstream service ui-service talks to (per Project LEDGER's
# microservices contract). Point this at wherever the orchestrator is
# actually running.
ORCHESTRATOR_URL=http://localhost:8000

# HTTP timeouts
REQUEST_TIMEOUT_SECONDS=60
HEALTH_TIMEOUT_SECONDS=5

# DPI used when rendering a cited PDF page for the evidence preview
EVIDENCE_RENDER_DPI=150

APP_TITLE=LEDGER — Financial Document Intelligence Agent
SHARE=False
