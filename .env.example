# Provider Options: "gemini" (Primary Default) | "groq" (Secondary Cloud) | "mock" (CI/unit testing stubs)
AGENT_LLM_PROVIDER=gemini

# Provider Keys - replace with your actual API keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Models
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Agent Control Parameters
AGENT_MAX_RETRIES=2
TOP_K=5

# Retrieval API
RETRIEVAL_API_URL=http://localhost:8001/search
