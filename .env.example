# orchestrator-api configuration
# Copy this file to `.env` and adjust if any teammate's service runs on a
# different host/port than the agreed contract.

HOST=0.0.0.0
PORT=8000

# Downstream services (must already be running before orchestrator-api starts)
AGENT_SERVICE_URL=http://localhost:8004
AGENT_QUERY_ENDPOINT=/query

VALIDATOR_SERVICE_URL=http://localhost:8006
VALIDATOR_ENDPOINT=/validate_answer

PROCESSOR_SERVICE_URL=http://localhost:8008
PROCESSOR_PROCESS_ENDPOINT=/process

RETRIEVAL_SERVICE_URL=http://localhost:8001
RETRIEVAL_INGEST_ENDPOINT=/ingest
# ASSUMPTION — confirm with retrieval-api owner (not in official contract yet)
RETRIEVAL_DOCUMENTS_ENDPOINT=/documents

# ui-service calls the Orchestrator, not the reverse — this is registered
# for /health reachability checks and CORS purposes only.
UI_SERVICE_URL=http://localhost:8007

# Behaviour
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=0.6
TOP_K=5

LOG_LEVEL=INFO
