# doc-processor-api — configuration template
#
# Copy to `.env` and edit. Every value below is the code default, so a
# straight copy changes nothing; the file exists so the whole configuration
# surface is visible in one place rather than discovered from settings.py.
#
#     cp .env.example .env
#
# Read by `app/core/settings.py` (pydantic-settings, prefix DOC_), resolved
# relative to the process working directory — so start the service from
# `doc-processor-api/` or the file is silently not found. Real environment
# variables win over anything set here, which is what lets a container or a
# CI job override one value without editing the file.
#
# Health at /health, readiness at /ready.

# ---------------------------------------------------------------------------
# Serving
# ---------------------------------------------------------------------------
# The port `python -m app.main` serves on. 8008 is this service's port.
#
# uvicorn's own --port wins when the server is started through its CLI, which
# is what a container or a process manager usually does:
#
#     python -m app.main                      # uses DOC_PORT
#     uvicorn app.main:app --port 8008        # --port wins
#
# The host is not settable here — it stays a uvicorn argument, and
# `python -m app.main` binds uvicorn's default 127.0.0.1.
DOC_PORT=8008

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Docling is the production document-processing path and the only backend the
# service registers: DocLayNet layout model + TableFormer cell structure.
# Any other value is refused at startup rather than substituted — a service
# quietly running a different backend than configured produces results nobody
# can reproduce. (The retired Phase 2 `textonly` control now lives in
# evaluation/textonly_baseline.py and is not selectable here.)
DOC_BACKEND=docling

# ---------------------------------------------------------------------------
# Upload limits — enforced before any model is asked to do work
# ---------------------------------------------------------------------------
# Rejected with FILE_TOO_LARGE (413). Must be > 0; a zero limit would refuse
# every upload, so the settings model will not start with one.
DOC_MAX_UPLOAD_MB=50

# Rejected with TOO_MANY_PAGES (422). Checked against the real page tree, not
# a header, so a small file claiming a huge document cannot slip through.
DOC_MAX_PAGES=100

# ---------------------------------------------------------------------------
# Page classification
# ---------------------------------------------------------------------------
# A page whose text layer yields fewer than this many characters is treated as
# scanned and routed to OCR.
DOC_TEXT_DENSITY_THRESHOLD=30

# Pages below this OCR confidence are flagged `low_confidence` for review
# rather than silently trusted. 0.0-1.0.
DOC_LOW_CONFIDENCE_THRESHOLD=0.75

# Rasterisation DPI for the OCR path.
DOC_RENDER_DPI=300

# ---------------------------------------------------------------------------
# Docling pipeline
# ---------------------------------------------------------------------------
# TableFormer's two modes are different systems, not a speed dial: they
# recover different grids and score differently. Which one ran is recorded in
# every document's processing.model_versions and in the cache key, so a
# backend comparison stays honest. `accurate` or `fast`.
DOC_DOCLING_TABLE_MODE=accurate

# Whether the docling pipeline may OCR. Left on so scanned pages are read
# rather than returned empty; born-digital pages still take their glyphs from
# the text layer, because force-OCR'ing a character-exact page can only
# introduce errors — and they would land in the figures being cited.
DOC_DOCLING_OCR=true

# Local model directory. Set for an air-gapped deployment so a parse never
# depends on reaching a model host. Leave commented out to let docling
# download and cache the weights itself — an empty value is a path, not
# "unset", so do not write `DOC_DOCLING_ARTIFACTS_PATH=`.
#DOC_DOCLING_ARTIFACTS_PATH=/opt/models/docling

# Inference thread count.
DOC_DOCLING_THREADS=4

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
# Content-addressed cache of assembled documents, keyed on sha256(pdf bytes) +
# a variant covering the backend's models and the processing version. Parsing
# TAT-DQA is ~37s per document, so the corpus is meant to be parsed once
# offline and served from here.
DOC_CACHE_ENABLED=true

# Relative to the working directory. Each backend configuration gets its own
# subdirectory, so entries can never be served across configurations.
DOC_CACHE_DIR=.cache/documents
