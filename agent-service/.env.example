# Choose hybrid (Gemini primary, Groq fallback), gemini, groq, or mock.
AGENT_LLM_PROVIDER=hybrid

# Hybrid mode requires both keys. Single-provider modes require only their key.
# GROQ_API_KEY is for Groq Cloud, not xAI Grok.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-120b

AGENT_MAX_RETRIES=2
TOP_K=5

RETRIEVAL_API_URL=http://localhost:8001
RETRIEVAL_MOCK=false
